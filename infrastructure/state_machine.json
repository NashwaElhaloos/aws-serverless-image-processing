{
  "StartAt": "ValidateImage",
  "States": {
    "ValidateImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "img-validate-fn",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "SendFailureAlert"
        }
      ],
      "Next": "ResizeImage"
    },
    "ResizeImage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "img-resize-fn",
        "Payload.$": "$.Payload"
      },
      "Next": "ApplyWatermark"
    },
    "ApplyWatermark": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "img-watermark-fn",
        "Payload.$": "$.Payload"
      },
      "Next": "SaveMetadata"
    },
    "SaveMetadata": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "img-metadata-fn",
        "Payload.$": "$.Payload"
      },
      "Next": "SendSuccessAlert"
    },
    "SendSuccessAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:123456789012:img-pipeline-alerts",
        "Message.$": "$.Payload"
      },
      "End": true
    },
    "SendFailureAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:123456789012:img-pipeline-alerts",
        "Message": "Image processing failed after 3 retries."
      },
      "End": true
    }
  }
}
